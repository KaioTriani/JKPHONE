# URL pública do site (usada em Open Graph, sitemap e JSON-LD)
NEXT_PUBLIC_SITE_URL=https://jkiphonebr.com.br

# Medição sem cookies (padrão). Deixe vazio para desligar.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Opcionais: só carregam depois do consentimento no banner.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Opcional: planilha do Google publicada como CSV (Arquivo > Compartilhar > Publicar na Web > CSV).
# Revalida a cada 5 min; se falhar, usa content/produtos.json.
PLANILHA_CSV_URL=

# Só para pré-visualização: deixa o build passar com pendências [CONFIRMAR].
# Nunca defina em produção.
PERMITIR_PENDENCIAS=
